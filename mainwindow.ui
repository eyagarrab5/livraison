    margin-top: 10px; /* Adjust margin as needed */
    background-color: #2a2a69; /* Darker shade of blue for background */
}

/* Title color */
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 3px;
    color: #87CEEB; /* Light blue: R: 135, G: 206, B: 235 */
}

/* Hover effect */
QGroupBox:hover {
    border: 2px solid #abdbe3; /* Change border color on hover */
}

/* Disabled state */
QGroupBox:disabled {
    border: 2px solid #a9a9a9; /* Dark grey border for disabled state */
}

/* Disabled title color */
QGroupBox:disabled::title {
    color: #d3d3d3; /* Light grey for disabled title */
}
</string>
