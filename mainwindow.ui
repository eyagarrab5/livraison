         <property name="styleSheet">
          <string notr="true">QTableView {
    background-color: #2a2a69; /* Darker shade of blue for background */
    border: 2px solid rgb(80, 80, 80); /* Dark grey: R: 80, G: 80, B: 80 */
    color: #87CEEB; /* Light blue: R: 135, G: 206, B: 235 */
    gridline-color: #1a1a49; /* Dark blue gridlines */
}

/* Header section */
QHeaderView::section {
    background-color: #2a2a69; /* Darker shade of blue for header background */
    color: #87CEEB; /* Light blue text for header */
    padding: 4px;
    border: 1px solid #1a1a49; /* Dark blue border for header sections */
}

/* Hover effect on header section */
QHeaderView::section:hover {
    background-color: #1a1a49; /* Dark blue on hover */
}

/* Selected item background color */
QTableView::item:selected {
    background-color: #1a1a49; /* Dark blue for selected item */
}

/* Alternate row background color */
QTableView::item:alternate {
    background-color: #2a2a69; /* Darker shade of blue for alternate rows */
}

/* Horizontal scrollbar */
QScrollBar:horizontal {
    background-color: #2a2a69; /* Darker shade of blue for scrollbar background */
    border: 2px solid #1a1a49; /* Dark blue border for scrollbar */
    height: 15px;
    margin: 0px 20px 0 20px;
}

/* Vertical scrollbar */
QScrollBar:vertical {
    background-color: #2a2a69; /* Darker shade of blue for scrollbar background */
    border: 2px solid #1a1a49; /* Dark blue border for scrollbar */
    width: 15px;
    margin: 20px 0 20px 0;
}

/* Handle on scrollbar */
QScrollBar::handle {
    background-color: #87CEEB; /* Light blue for scrollbar handle */
    border-radius: 8px; /* Adjust border radius as needed */
}

/* Handle on scrollbar when pressed */
QScrollBar::handle:pressed {
    background-color: #5F9EA0; /* Darker shade of blue when handle is pressed */
}
