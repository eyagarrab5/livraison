      <property name="styleSheet">
       <string notr="true">QTabWidget {
    background-color: #f0f0f0;
}

/* Set rounded corners for the tab bar */
QTabBar {
    border-radius: 5px;
    border: 1px solid black; /* Add a 1px black border */
}

/* Increase spacing between tabs */
QTabBar::tab {
    margin-left: 0px; /* Adjust spacing as needed */
    margin-right: 0px; /* Adjust spacing as needed */
}

/* Increase tab size and add horizontal padding */
QTabBar::tab {
    min-width: 70px; /* Adjust width as needed */
    min-height: 30px; /* Adjust height as needed */
    padding: 0px 10px; /* Add 5px padding on top/bottom, 10px on left/right */
}

/* Set background color and text color for individual tabs */
QTabBar::tab {
    background-color: #193b68;
    color: white;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border: 1px solid black; /* Add a 1px black border for each tab */
}

/* Change background and text color for selected tab */
QTabBar::tab:selected {
    background-color: #abdbe3;
    color: white;
}
</string>
